#!/usr/bin/env python3
import argparse
import logging

import symdrift.cli as cli

logger = logging.getLogger(__name__)


def parse_kv_list(kv_list):
    out = {}
    for item in kv_list:
        key, value = item.split("=")
        try:
            value = eval(value)  # or safer: use ast.literal_eval
        except:
            logger.warning(
                f"Could not parse value for key '{key}'. Using string value '{value}' instead."
            )
            pass
        out[key] = value
    return out


if __name__ == "__main__":
    parser = argparse.ArgumentParser(
        description="Evaluate generated molecules against dataset."
    )

    parser.add_argument(
        "--path_generated", "-pg", type=str, help="Path to generated atoms (.xyz)"
    )

    parser.add_argument(
        "--path_dataset", "-pd", type=str, help="Path to dataset atoms (.xyz)"
    )

    parser.add_argument(
        "--num_workers",
        "-nw",
        type=int,
        default=8,
        help="Number of workers (default: 8)",
    )

    parser.add_argument(
        "--worker_fn_type",
        "-wft",
        type=str,
        default="rmsd_rdkit_wo_h",
        help="Worker function type (default: rmsd_rdkit_wo_h)",
    )

    parser.add_argument(
        "--worker_fn_kwargs",
        "-wfk",
        nargs="*",
        default=[],
        help="Additional keyword arguments for worker function, in the form key=value (default: empty)",
    )

    parser.add_argument(
        "--ratio", "-r", type=int, default=2, help="Ratio parameter (default: 2)"
    )

    parser.add_argument(
        "--threshold",
        "-t",
        type=float,
        default=0.5,
        help="Threshold for similarity (default: 0.5)",
    )

    parser.add_argument(
        "--identifier",
        "-id",
        type=str,
        default="smiles",
        help="Identifier for molecules (default: smiles)",
    )

    parser.add_argument(
        "--skip_disconnected",
        "-sd",
        action="store_true",
        default=True,
        help="Skip disconnected ground truth graphs during evaluation",
    )

    parser.add_argument(
        "--save_folder",
        "-sf",
        type=str,
        default="covmat_evaluation_results",
        help="Folder to save results (default: covmat_evaluation_results)",
    )

    parser.add_argument(
        "--logging_level",
        "-ll",
        type=str,
        default="INFO",
        help="Logging level (default: INFO)",
    )

    args = parser.parse_args()

    logging.basicConfig(level=getattr(logging, args.logging_level))

    job_kwargs = parse_kv_list(args.worker_fn_kwargs)

    cli.run_covmat_evaluation(
        path_generated=args.path_generated,
        path_dataset=args.path_dataset,
        num_workers=args.num_workers,
        worker_fn_type=args.worker_fn_type,
        threshold=args.threshold,
        ratio=args.ratio,
        save_folder=args.save_folder,
        identifier=args.identifier,
        skip_disconnected=args.skip_disconnected,
        **job_kwargs,
    )
