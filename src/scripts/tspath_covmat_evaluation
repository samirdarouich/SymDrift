#!/usr/bin/env python3
import argparse
import logging

import tspath.cli as cli

logging.basicConfig(level=logging.INFO)

if __name__ == "__main__":
    parser = argparse.ArgumentParser(
        description="Evaluate generated molecules against dataset."
    )

    parser.add_argument(
        "--path_generated", type=str, help="Path to generated atoms (.xyz)"
    )

    parser.add_argument("--path_dataset", type=str, help="Path to dataset atoms (.xyz)")

    parser.add_argument(
        "--num_workers", type=int, default=8, help="Number of workers (default: 8)"
    )

    parser.add_argument(
        "--worker_fn_type",
        type=str,
        default="rmsd_rdkit_wo_h",
        help="Worker function type (default: rmsd_rdkit_wo_h)",
    )

    parser.add_argument(
        "--ratio", type=int, default=2, help="Ratio parameter (default: 2)"
    )

    parser.add_argument(
        "--threshold",
        type=float,
        default=0.5,
        help="Threshold for similarity (default: 0.5)",
    )

    parser.add_argument(
        "--save_folder",
        type=str,
        default="covmat_evaluation_results",
        help="Folder to save results (default: covmat_evaluation_results)",
    )

    args = parser.parse_args()

    cli.run_covmat_evaluation(
        path_generated=args.path_generated,
        path_dataset=args.path_dataset,
        num_workers=args.num_workers,
        worker_fn_type=args.worker_fn_type,
        threshold=args.threshold,
        ratio=args.ratio,
        save_folder=args.save_folder,
    )
